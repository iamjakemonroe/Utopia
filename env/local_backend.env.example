# The local backend (tool/local_backend): runs the web-pay, web-pay-hook and
# chip-rizz functions on this Mac against the live project, so payments and
# Chip Rizz can be tried without deploying anything.
# Copy to env/local_backend.env (git-ignored) and fill in:
#
# Supabase dashboard > Project settings > API keys > Legacy: anon and service_role.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For Chip Rizz (console.anthropic.com > API keys). Payments work without it.
ANTHROPIC_API_KEY=
# Where checkout sends people back (the local game and the local Chip Rizz).
UTOPIA_RETURN_URL=http://localhost:8080/
CHIP_RETURN_URL=http://localhost:5180/
