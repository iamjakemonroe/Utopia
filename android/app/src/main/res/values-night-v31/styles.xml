<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces launch_background with the system splash
         (app icon on a solid color), so its color is set here explicitly;
         otherwise it falls back to the theme's white/black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/utopia_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/utopia_background</item>
    </style>
</resources>
